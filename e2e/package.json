{
  "name": "sharecart-e2e",
  "private": true,
  "type": "module",
  "description": "Appium (WebdriverIO + TypeScript) end-to-end tests for the ShareCart Android app",
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "test:spec": "wdio run ./wdio.conf.ts --spec",
    "typecheck": "tsc --noEmit",
    "appium:driver": "appium driver install uiautomator2",
    "appium:doctor": "appium driver doctor uiautomator2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@wdio/appium-service": "^10.0.1",
    "@wdio/cli": "^10.0.1",
    "@wdio/globals": "^10.0.1",
    "@wdio/local-runner": "^10.0.1",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "appium": "^3.8.0",
    "typescript": "~6.0.3",
    "webdriverio": "^10.0.1",
    "@supabase/supabase-js": "^2.117.3"
  }
}
