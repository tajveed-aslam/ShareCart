# Supabase project settings → API. The publishable (anon) key is safe to ship in the app: Row Level Security is what
# protects the data. Never put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
